DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
ALERA_JWT_SECRET=replace-with-a-long-random-secret
ALERA_JWT_ACCESS_TOKEN_MINUTES=60
REMINDER_LIFECYCLE_SECRET=replace-with-a-separate-long-random-secret
ALERA_DEMO_CAREGIVER_EMAIL=caregiver@example.com
ALERA_DEMO_CAREGIVER_PASSWORD=replace-with-a-demo-password
ALERA_DEMO_PATIENT_ID=replace-with-demo-patient-uuid

# Optional caregiver push delivery. Store credentials only in environment secrets.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
